```csharp
using Microsoft.EntityFrameworkCore;
using Microsoft.Extensions.Caching.Distributed;
using System.Text.Json;
using System.Threading.Tasks;

public interface ISchoolService
{
    Task<Student?> GetStudent(int id);
    Task<Student?> DeleteStudent(int id);
}

public class SchoolService : ISchoolService
{
    private readonly SchoolContext _db;
    private readonly IDistributedCache _cache;

    public SchoolService(SchoolContext db, IDistributedCache cache)
    {
        _db = db;
        _cache = cache;
    }

    public async Task<Student?> GetStudent(int id)
    {
        Student? student = null;

        var studentString = await _cache.GetStringAsync(id.ToString());
        if (!string.IsNullOrEmpty(studentString))
        {
            student = JsonSerializer.Deserialize<Student>(studentString);
            Console.WriteLine($"{student.FirstName} {student.LastName} извлечён из кэша");
        }
        else
        {
            student = await _db.Students
                .Include(s => s.Class)
                .FirstOrDefaultAsync(s => s.Id == id);

            if (student != null)
            {
                Console.WriteLine($"{student.FirstName} {student.LastName} извлечён из базы данных");

                var options = new DistributedCacheEntryOptions
                {
                    AbsoluteExpirationRelativeToNow = TimeSpan.FromMinutes(2)
                };

                await _cache.SetStringAsync(student.Id.ToString(), JsonSerializer.Serialize(student), options);
                Console.WriteLine($"Сохранено в кэш на 2 минуты");
            }
        }

        return student;
    }

    public async Task<Student?> DeleteStudent(int id)
    {
        var student = await _db.Students.FindAsync(id);
        if (student == null) return null;

        _db.Students.Remove(student);
        await _db.SaveChangesAsync();

        await _cache.RemoveAsync(id.ToString());
        Console.WriteLine($"Кэш по ключу {id} очищен");

        return student;
    }
}
```

