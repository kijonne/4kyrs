📄 Файл 2: Form1.cs

```csharp
using System;
using System.Windows.Forms;

namespace MailApp
{
    public partial class Form1 : Form
    {
        Database db = new Database("mail.db");

        public Form1()
        {
            InitializeComponent();
            // Скрываем панель сообщений до авторизации
            lstMessages.Visible = false;
            btnRefresh.Visible = false;
            btnTrash.Visible = false;
            btnSend.Visible = false;
            btnFilter.Visible = false;
        }

        // Авторизация
        private void btnLogin_Click(object sender, EventArgs e)
        {
            if (db.Login(txtEmail.Text, txtPassword.Text))
            {
                MessageBox.Show("Добро пожаловать!");
                txtEmail.Visible = false;
                txtPassword.Visible = false;
                btnLogin.Visible = false;
                lstMessages.Visible = true;
                btnRefresh.Visible = true;
                btnTrash.Visible = true;
                btnSend.Visible = true;
                btnFilter.Visible = true;
                LoadMessages();
            }
            else
            {
                MessageBox.Show("Неверный email или пароль!");
            }
        }

        // Загрузка сообщений
        private void LoadMessages()
        {
            lstMessages.Items.Clear();
            var reader = db.GetMessages();
            while (reader.Read())
                lstMessages.Items.Add($"[{reader["id"]}] {reader["sender"]}: {reader["text"]}");
            reader.Close();
        }

        // Обновить
        private void btnRefresh_Click(object sender, EventArgs e)
        {
            LoadMessages();
        }

        // Корзина
        private void btnTrash_Click(object sender, EventArgs e)
        {
            lstMessages.Items.Clear();
            var reader = db.GetTrash();
            while (reader.Read())
                lstMessages.Items.Add($"[{reader["id"]}] {reader["sender"]}: {reader["text"]}");
            reader.Close();
        }

        // Удалить по двойному клику
        private void lstMessages_DoubleClick(object sender, EventArgs e)
        {
            if (lstMessages.SelectedItem == null) return;
            string s = lstMessages.SelectedItem.ToString();
            int id = int.Parse(s.Substring(1, s.IndexOf(']') - 1));
            db.DeleteMessage(id);
            LoadMessages();
        }

        // Заглушки (5.7.1)
        private void btnSend_Click(object sender, EventArgs e)
        {
            MessageBox.Show("Заглушка: отправка сообщений");
        }

        private void btnFilter_Click(object sender, EventArgs e)
        {
            MessageBox.Show("Заглушка: фильтрация");
        }
    }
}
```

