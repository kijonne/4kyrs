📄 Файл 1: Database.cs

Создай новый файл в проекте: правой кнопкой на проекте → Add → Class → назови Database.cs.

```csharp
using System;
using System.Data.SQLite;
using System.IO;

namespace MailApp
{
    public class Database
    {
        private string connectionString;

        public Database(string dbPath)
        {
            connectionString = $"Data Source={dbPath};Version=3;";
            if (!File.Exists(dbPath))
                SQLiteConnection.CreateFile(dbPath);
            CreateTables();
        }

        // 5.4.2 Создание таблиц
        private void CreateTables()
        {
            using (var conn = new SQLiteConnection(connectionString))
            {
                conn.Open();
                new SQLiteCommand(
                    "CREATE TABLE IF NOT EXISTS users (id INTEGER PRIMARY KEY AUTOINCREMENT, email TEXT, password TEXT, name TEXT)",
                    conn).ExecuteNonQuery();

                new SQLiteCommand(
                    "CREATE TABLE IF NOT EXISTS messages (id INTEGER PRIMARY KEY AUTOINCREMENT, sender TEXT, receiver TEXT, text TEXT, date TEXT, is_deleted INTEGER DEFAULT 0)",
                    conn).ExecuteNonQuery();

                // Тестовые данные
                var check = new SQLiteCommand("SELECT COUNT(*) FROM users", conn);
                if (Convert.ToInt64(check.ExecuteScalar()) == 0)
                {
                    new SQLiteCommand("INSERT INTO users (email, password, name) VALUES ('test@mail.com', '123', 'Тест')", conn).ExecuteNonQuery();
                    new SQLiteCommand("INSERT INTO messages (sender, receiver, text, date) VALUES ('boss@mail.com', 'test@mail.com', 'Привет!', '2026-09-25')", conn).ExecuteNonQuery();
                    new SQLiteCommand("INSERT INTO messages (sender, receiver, text, date) VALUES ('friend@mail.com', 'test@mail.com', 'Пойдем гулять?', '2026-09-25')", conn).ExecuteNonQuery();
                }
            }
        }

        // Авторизация
        public bool Login(string email, string password)
        {
            using (var conn = new SQLiteConnection(connectionString))
            {
                conn.Open();
                var cmd = new SQLiteCommand("SELECT COUNT(*) FROM users WHERE email=@e AND password=@p", conn);
                cmd.Parameters.AddWithValue("@e", email);
                cmd.Parameters.AddWithValue("@p", password);
                return Convert.ToInt64(cmd.ExecuteScalar()) > 0;
            }
        }

        // Получить сообщения (is_deleted = 0)
        public SQLiteDataReader GetMessages()
        {
            var conn = new SQLiteConnection(connectionString);
            conn.Open();
            var cmd = new SQLiteCommand("SELECT id, sender, text FROM messages WHERE is_deleted=0", conn);
            return cmd.ExecuteReader();
        }

        // Получить корзину (is_deleted = 1)
        public SQLiteDataReader GetTrash()
        {
            var conn = new SQLiteConnection(connectionString);
            conn.Open();
            var cmd = new SQLiteCommand("SELECT id, sender, text FROM messages WHERE is_deleted=1", conn);
            return cmd.ExecuteReader();
        }

        // Удалить сообщение (в корзину)
        public void DeleteMessage(int id)
        {
            using (var conn = new SQLiteConnection(connectionString))
            {
                conn.Open();
                var cmd = new SQLiteCommand("UPDATE messages SET is_deleted=1 WHERE id=@id", conn);
                cmd.Parameters.AddWithValue("@id", id);
                cmd.ExecuteNonQuery();
            }
        }
    }
}
```

