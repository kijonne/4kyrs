using System.Windows;
using System.Windows.Controls;

namespace ChudoObuv;

public partial class MainWindow : Window
{
    private bool _ready; // события контролов срабатывают при InitializeComponent, пока всё не создано

    public MainWindow()
    {
        InitializeComponent();

        Role role = Session.CurrentRole;
        bool isAuthorized = role != Role.Guest;

        FioText.Text = Session.CurrentUser?.Fio ?? "Гость";
        FilterPanel.Visibility = isAuthorized ? Visibility.Visible : Visibility.Collapsed;
        CartButton.Visibility = isAuthorized ? Visibility.Visible : Visibility.Collapsed;
        OrdersButton.Visibility = (role == Role.Manager || role == Role.Admin)
            ? Visibility.Visible : Visibility.Collapsed;

        List<string> categories = Session.Products.Select(p => p.Category).Distinct().OrderBy(c => c).ToList();
        categories.Insert(0, "Все категории");
        CategoryBox.ItemsSource = categories;
        CategoryBox.SelectedIndex = 0;

        SortBox.ItemsSource = new[] { "Цена по возрастанию", "Цена по убыванию" };
        SortBox.SelectedIndex = 0;

        _ready = true;
        UpdateList();
    }

    private void Filter_Changed(object sender, RoutedEventArgs e)
    {
        UpdateList();
    }

    // Фильтр, поиск и сортировка применяются вместе
    private void UpdateList()
    {
        if (!_ready)
        {
            return;
        }

        IEnumerable<Product> list = Session.Products;

        if (CategoryBox.SelectedIndex > 0)
        {
            string category = (string)CategoryBox.SelectedItem;
            list = list.Where(p => p.Category == category);
        }

        string text = SearchBox.Text.Trim();
        if (text != "")
        {
            list = list.Where(p => p.Name.Contains(text, StringComparison.CurrentCultureIgnoreCase)
                                   || p.Description.Contains(text, StringComparison.CurrentCultureIgnoreCase));
        }

        list = SortBox.SelectedIndex == 1
            ? list.OrderByDescending(p => p.FinalPrice)
            : list.OrderBy(p => p.FinalPrice);

        ProductList.ItemsSource = list.ToList();
        CartButton.Content = $"Корзина ({Session.Cart.Sum(i => i.Quantity)})";
    }

    private void ProductList_SelectionChanged(object sender, SelectionChangedEventArgs e)
    {
        if (ProductList.SelectedItem is not Product product)
        {
            return;
        }
        ProductList.SelectedItem = null; // сбрасываем выбор, чтобы можно было нажать на тот же товар снова

        if (Session.CurrentRole == Role.Guest)
        {
            MessageBox.Show("Чтобы заказать товар, войдите в систему под своим логином.",
                "Требуется вход", MessageBoxButton.OK, MessageBoxImage.Information);
            return;
        }

        new ProductWindow(product) { Owner = this }.ShowDialog();
        UpdateList();
    }

    private void CartButton_Click(object sender, RoutedEventArgs e)
    {
        new CartWindow { Owner = this }.ShowDialog();
        UpdateList();
    }

    private void OrdersButton_Click(object sender, RoutedEventArgs e)
    {
        new OrdersWindow { Owner = this }.ShowDialog();
        UpdateList();
    }

    private void LogoutButton_Click(object sender, RoutedEventArgs e)
    {
        if (Session.Cart.Count > 0)
        {
            MessageBoxResult result = MessageBox.Show(
                "В корзине есть несохранённые товары. При выходе заказ будет сброшен. Выйти?",
                "Предупреждение", MessageBoxButton.YesNo, MessageBoxImage.Warning);
            if (result != MessageBoxResult.Yes)
            {
                return;
            }
        }

        Session.CurrentUser = null;
        Session.Cart.Clear();
        new LoginWindow().Show();
        Close();
    }
}
