using System.IO;
using System.Windows.Media.Imaging;

namespace ChudoObuv;

public enum Role { Guest, Client, Manager, Admin }

public class User
{
    public string Login { get; set; }
    public string Surname { get; set; }
    public string Name { get; set; }
    public string Patronymic { get; set; }
    public Role Role { get; set; }
    public string Fio => $"{Surname} {Name} {Patronymic}";
}

public class ProductSize
{
    public int Size { get; set; }
    public int Quantity { get; set; }
    public string Display => $"{Size} (в наличии: {Quantity})";
}

public class Product
{
    public int Id { get; set; }
    public string Name { get; set; }
    public string Manufacturer { get; set; }
    public string Category { get; set; }
    public string Composition { get; set; }
    public string Description { get; set; }
    public decimal BasePrice { get; set; }
    public string ImagePath { get; set; } // имя файла в папке Images рядом с exe, может быть пустым
    public List<ProductSize> Sizes { get; set; } = new();

    public string Title => $"{Manufacturer} | {Name}";
    public int TotalQuantity => Sizes.Sum(s => s.Quantity);
    public string QuantityText => TotalQuantity > 5 ? "много" : "мало";
    public bool IsLowStock => TotalQuantity <= 3;
    public decimal FinalPrice => Session.GetPrice(this);

    public BitmapImage Image
    {
        get
        {
            string path = string.IsNullOrEmpty(ImagePath)
                ? null
                : Path.Combine(AppContext.BaseDirectory, "Images", ImagePath);
            Uri uri = (path != null && File.Exists(path))
                ? new Uri(path)
                : new Uri("pack://application:,,,/Resources/picture.png");
            return new BitmapImage(uri);
        }
    }
}

public class OrderItem
{
    public Product Product { get; set; }
    public int Size { get; set; }
    public int Quantity { get; set; }
    public decimal UnitPrice { get; set; } // цена со скидкой на момент добавления

    public string Description => $"{Product.Title}, размер {Size}";
    public decimal Sum => Quantity * UnitPrice;
}

public class Order
{
    public int Id { get; set; }
    public DateTime Date { get; set; }
    public User Client { get; set; }
    public List<OrderItem> Items { get; set; } = new();

    public string DateText => Date.ToString("dd.MM.yyyy HH:mm");
    public string ClientFio => Client.Fio;
    public decimal Total => Items.Sum(i => i.Sum);
}
