using System.Windows;
using System.Windows.Controls;

namespace ChudoObuv;

public partial class CartWindow : Window
{
    public CartWindow()
    {
        InitializeComponent();

        bool isStaff = Session.CurrentRole == Role.Manager || Session.CurrentRole == Role.Admin;
        ClientPanel.Visibility = isStaff ? Visibility.Visible : Visibility.Collapsed;
        ClientBox.ItemsSource = Session.Users.Where(u => u.Role == Role.Client).ToList();

        RefreshCart();
    }

    private void RefreshCart()
    {
        CartList.ItemsSource = null;
        CartList.ItemsSource = Session.Cart;
        TotalText.Text = $"Итого: {Session.Cart.Sum(i => i.Sum):N2} руб.";
    }

    private static OrderItem GetItem(object sender)
    {
        return (OrderItem)((FrameworkElement)sender).DataContext;
    }

    private void Minus_Click(object sender, RoutedEventArgs e)
    {
        OrderItem item = GetItem(sender);
        if (item.Quantity > 1)
        {
            item.Quantity--;
            RefreshCart();
        }
    }

    private void Plus_Click(object sender, RoutedEventArgs e)
    {
        OrderItem item = GetItem(sender);
        ProductSize size = item.Product.Sizes.First(s => s.Size == item.Size);
        if (item.Quantity >= size.Quantity)
        {
            MessageBox.Show($"Больше пар размера {item.Size} для этой модели нет в наличии.",
                "Недостаточно товара", MessageBoxButton.OK, MessageBoxImage.Warning);
            return;
        }
        item.Quantity++;
        RefreshCart();
    }

    private void Remove_Click(object sender, RoutedEventArgs e)
    {
        Session.Cart.Remove(GetItem(sender));
        RefreshCart();
    }

    private void ConfirmButton_Click(object sender, RoutedEventArgs e)
    {
        if (Session.Cart.Count == 0)
        {
            MessageBox.Show("Заказ пуст. Вернитесь в каталог и добавьте товары.", "Пустой заказ",
                MessageBoxButton.OK, MessageBoxImage.Warning);
            return;
        }

        User client = Session.CurrentUser;
        if (ClientPanel.Visibility == Visibility.Visible)
        {
            client = ClientBox.SelectedItem as User;
            if (client == null)
            {
                MessageBox.Show("Выберите клиента, на которого оформляется заказ.", "Клиент не выбран",
                    MessageBoxButton.OK, MessageBoxImage.Warning);
                return;
            }
        }

        MessageBoxResult answer = MessageBox.Show(
            $"Подтвердить заказ на сумму {Session.Cart.Sum(i => i.Sum):N2} руб.?",
            "Подтверждение заказа", MessageBoxButton.YesNo, MessageBoxImage.Question);
        if (answer != MessageBoxResult.Yes)
        {
            return;
        }

        // Повторная проверка остатков перед списанием
        foreach (OrderItem item in Session.Cart)
        {
            ProductSize size = item.Product.Sizes.First(s => s.Size == item.Size);
            if (size.Quantity < item.Quantity)
            {
                MessageBox.Show($"Товара «{item.Description}» осталось {size.Quantity} пар. Уменьшите количество.",
                    "Недостаточно товара", MessageBoxButton.OK, MessageBoxImage.Error);
                return;
            }
        }

        foreach (OrderItem item in Session.Cart)
        {
            item.Product.Sizes.First(s => s.Size == item.Size).Quantity -= item.Quantity;
        }

        Session.Orders.Add(new Order
        {
            Id = Session.Orders.Count == 0 ? 1 : Session.Orders.Max(o => o.Id) + 1,
            Date = DateTime.Now,
            Client = client,
            Items = Session.Cart.ToList()
        });
        Session.Cart.Clear();

        MessageBox.Show("Заказ оформлен.", "Готово", MessageBoxButton.OK, MessageBoxImage.Information);
        Close();
    }

    private void CancelOrderButton_Click(object sender, RoutedEventArgs e)
    {
        if (Session.Cart.Count == 0)
        {
            Close();
            return;
        }

        MessageBoxResult answer = MessageBox.Show("Сформированный заказ будет сброшен. Продолжить?",
            "Отказ от заказа", MessageBoxButton.YesNo, MessageBoxImage.Warning);
        if (answer == MessageBoxResult.Yes)
        {
            Session.Cart.Clear();
            Close();
        }
    }

    private void BackButton_Click(object sender, RoutedEventArgs e)
    {
        Close();
    }
}
