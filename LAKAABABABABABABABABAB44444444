    {
        string login = LoginBox.Text.Trim();
        if (login == "")
        {
            MessageBox.Show("Введите логин и нажмите «Войти».", "Ошибка входа",
                MessageBoxButton.OK, MessageBoxImage.Warning);
            return;
        }

        User user = Session.Users.FirstOrDefault(u =>
            string.Equals(u.Login, login, StringComparison.OrdinalIgnoreCase));
        if (user == null)
        {
            MessageBox.Show("Пользователь с таким логином не найден. Проверьте логин и повторите ввод.",
                "Ошибка входа", MessageBoxButton.OK, MessageBoxImage.Error);
            return;
        }

        OpenMain(user);
    }

    private void GuestButton_Click(object sender, RoutedEventArgs e)
    {
        OpenMain(null);
    }

    private void OpenMain(User user)
    {
        Session.CurrentUser = user;
        Session.Cart.Clear();
        new MainWindow().Show();
        Close();
    }
}
