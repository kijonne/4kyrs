using System.Windows;

namespace ChudoObuv;

public partial class OrderDetailsWindow : Window
{
    private readonly Order _order;

    public OrderDetailsWindow(Order order, bool isEditMode)
    {
        InitializeComponent();
        _order = order;

        Title = isEditMode ? "Чудо Обувь — Редактирование заказа" : "Чудо Обувь — Состав заказа";
        ClientText.Text = $"Клиент: {order.ClientFio}";

        // Редактирование (дата, удаление позиций) — только для администратора
        DatePickerBox.Visibility = isEditMode ? Visibility.Visible : Visibility.Collapsed;
        DateText.Visibility = isEditMode ? Visibility.Collapsed : Visibility.Visible;
        DeleteItemButton.Visibility = isEditMode ? Visibility.Visible : Visibility.Collapsed;
        SaveButton.Visibility = isEditMode ? Visibility.Visible : Visibility.Collapsed;

        DateText.Text = order.DateText;
        DatePickerBox.SelectedDate = order.Date.Date;
        RefreshItems();
    }

    private void RefreshItems()
    {
        ItemsGrid.ItemsSource = null;
        ItemsGrid.ItemsSource = _order.Items;
        TotalText.Text = $"Итого: {_order.Total:N2} руб.";
    }

    private void DeleteItemButton_Click(object sender, RoutedEventArgs e)
    {
        if (ItemsGrid.SelectedItem is not OrderItem item)
        {
            MessageBox.Show("Выберите позицию в списке.", "Позиция не выбрана",
                MessageBoxButton.OK, MessageBoxImage.Information);
            return;
        }

        if (_order.Items.Count == 1)
        {
            MessageBox.Show("Нельзя удалить последнюю позицию. Удалите заказ целиком в списке заказов.",
                "Запрещённое действие", MessageBoxButton.OK, MessageBoxImage.Warning);
            return;
        }

        MessageBoxResult answer = MessageBox.Show("Позиция будет удалена из заказа, товар вернётся в остаток. Продолжить?",
            "Удаление позиции", MessageBoxButton.YesNo, MessageBoxImage.Warning);
        if (answer != MessageBoxResult.Yes)
        {
            return;
        }

        Session.ReturnToStock(item);
        _order.Items.Remove(item);
        RefreshItems();
    }

    private void SaveButton_Click(object sender, RoutedEventArgs e)
    {
        if (DatePickerBox.SelectedDate == null)
        {
            MessageBox.Show("Укажите дату заказа.", "Дата не указана",
                MessageBoxButton.OK, MessageBoxImage.Error);
            return;
        }

        _order.Date = DatePickerBox.SelectedDate.Value.Date + _order.Date.TimeOfDay;
        MessageBox.Show("Изменения сохранены.", "Готово", MessageBoxButton.OK, MessageBoxImage.Information);
        Close();
    }

    private void BackButton_Click(object sender, RoutedEventArgs e)
    {
        Close();
    }
}
