namespace ChudoObuv;

// Текущий пользователь, корзина и тестовые данные. Позже заменить на работу с БД.
public static class Session
{
    public static User CurrentUser; // null = неавторизованный
    public static Role CurrentRole => CurrentUser?.Role ?? Role.Guest;

    public static List<User> Users = new();
    public static List<Product> Products = new();
    public static List<Order> Orders = new();
    public static List<OrderItem> Cart = new();

    static Session()
    {
        Users.Add(new User { Login = "admin", Surname = "Петров", Name = "Пётр", Patronymic = "Петрович", Role = Role.Admin });
        Users.Add(new User { Login = "manager", Surname = "Сидорова", Name = "Анна", Patronymic = "Ивановна", Role = Role.Manager });
        Users.Add(new User { Login = "client1", Surname = "Иванов", Name = "Иван", Patronymic = "Иванович", Role = Role.Client });
        Users.Add(new User { Login = "client2", Surname = "Смирнова", Name = "Ольга", Patronymic = "Сергеевна", Role = Role.Client });

        Products.Add(MakeProduct(1, "Ботинки зимние", "Rieker", "Мужская обувь", 4500,
            "Верх: натуральная кожа; подкладка: мех; подошва: резина", new[] { (41, 3), (42, 4), (43, 2) }));
        Products.Add(MakeProduct(2, "Туфли классические", "Kari", "Женская обувь", 3900,
            "Верх: искусственная кожа; подкладка: текстиль; подошва: ТЭП", new[] { (36, 1), (37, 1) }));
        Products.Add(MakeProduct(3, "Кроссовки спортивные", "Ecco", "Детская обувь", 3100,
            "Верх: текстиль; подкладка: текстиль; подошва: ЭВА", new[] { (30, 2), (31, 2), (32, 2) }));
        Products.Add(MakeProduct(4, "Сапоги осенние", "Respect", "Женская обувь", 5200,
            "Верх: натуральная кожа; подкладка: байка; подошва: резина", new[] { (37, 1), (38, 2), (39, 1) }));
        Products.Add(MakeProduct(5, "Сандалии летние", "Ecco", "Мужская обувь", 2800,
            "Верх: текстиль; подкладка: текстиль; подошва: ЭВА", new[] { (41, 1), (42, 1), (43, 1) }));
        Products.Add(MakeProduct(6, "Ботильоны", "Kari", "Женская обувь", 4100,
            "Верх: замша; подкладка: текстиль; подошва: ТЭП", new[] { (38, 5), (39, 5) }));

        // Заказ в прошлом месяце: модели 1 и 3 без скидки, остальные со скидкой 25%
        DateTime lastMonth = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).AddMonths(-1).AddDays(14);
        Orders.Add(new Order
        {
            Id = 1, Date = lastMonth, Client = Users[2],
            Items = new List<OrderItem>
            {
                new OrderItem { Product = Products[0], Size = 42, Quantity = 1, UnitPrice = 4500 },
                new OrderItem { Product = Products[2], Size = 31, Quantity = 1, UnitPrice = 3100 }
            }
        });
        Orders.Add(new Order
        {
            Id = 2, Date = DateTime.Today, Client = Users[3],
            Items = new List<OrderItem>
            {
                new OrderItem { Product = Products[1], Size = 36, Quantity = 1, UnitPrice = 2925 }
            }
        });
    }

    private static Product MakeProduct(int id, string name, string manufacturer, string category,
        decimal price, string composition, (int size, int qty)[] sizes)
    {
        return new Product
        {
            Id = id, Name = name, Manufacturer = manufacturer, Category = category,
            BasePrice = price, Composition = composition,
            Description = $"{name} от {manufacturer}. Удобная модель на каждый день.",
            Sizes = sizes.Select(s => new ProductSize { Size = s.size, Quantity = s.qty }).ToList()
        };
    }

    // Скидка 25%, если у модели нет заказов в предыдущем календарном месяце
    public static decimal GetPrice(Product product)
    {
        DateTime thisMonthStart = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
        DateTime prevMonthStart = thisMonthStart.AddMonths(-1);

        bool hadOrders = Orders.Any(o => o.Date >= prevMonthStart && o.Date < thisMonthStart
                                         && o.Items.Any(i => i.Product.Id == product.Id));

        return hadOrders ? product.BasePrice : Math.Round(product.BasePrice * 0.75m, 2);
    }

    public static void ReturnToStock(OrderItem item)
    {
        ProductSize size = item.Product.Sizes.FirstOrDefault(s => s.Size == item.Size);
        if (size != null)
        {
            size.Quantity += item.Quantity;
        }
    }
}
