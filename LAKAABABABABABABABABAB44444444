using System.Windows;
using System.Windows.Input;

namespace ChudoObuv;

public partial class ProductWindow : Window
{
    private readonly Product _product;

    public ProductWindow(Product product)
    {
        InitializeComponent();
        _product = product;

        ProductImage.Source = product.Image;
        NameText.Text = product.Name;
        ManufacturerText.Text = $"Производство: {product.Manufacturer}";
        CategoryText.Text = $"Категория: {product.Category}";
        PriceText.Text = $"Цена: {product.FinalPrice:N2} руб.";
        CompositionText.Text = $"Состав: {product.Composition}";
        DescriptionText.Text = $"Описание: {product.Description}";

        List<ProductSize> available = product.Sizes.Where(s => s.Quantity > 0).ToList();
        AllSizesText.Text = "Размерный ряд: " + string.Join(", ", product.Sizes.Select(s => s.Size));
        AvailableSizesText.Text = "Доступные для заказа размеры: "
            + (available.Count > 0 ? string.Join(", ", available.Select(s => s.Size)) : "нет");
        SizeBox.ItemsSource = available;
    }

    // В поле количества можно вводить только цифры
    private void QuantityBox_PreviewTextInput(object sender, TextCompositionEventArgs e)
    {
        e.Handled = !e.Text.All(char.IsDigit);
    }

    private void AddButton_Click(object sender, RoutedEventArgs e)
    {
        if (SizeBox.SelectedItem is not ProductSize size)
        {
            MessageBox.Show("Выберите размер из списка доступных.", "Размер не выбран",
                MessageBoxButton.OK, MessageBoxImage.Warning);
            return;
        }

        if (!int.TryParse(QuantityBox.Text, out int quantity) || quantity < 1)
        {
            MessageBox.Show("Введите количество пар — целое число не меньше 1.", "Неверное количество",
                MessageBoxButton.OK, MessageBoxImage.Error);
            return;
        }

        OrderItem inCart = Session.Cart.FirstOrDefault(i => i.Product.Id == _product.Id && i.Size == size.Size);
        int alreadyInCart = inCart?.Quantity ?? 0;

        if (quantity + alreadyInCart > size.Quantity)
        {
            MessageBox.Show($"Для размера {size.Size} доступно {size.Quantity} пар, в заказе уже {alreadyInCart}. " +
                            "Уменьшите количество.", "Недостаточно товара",
                MessageBoxButton.OK, MessageBoxImage.Warning);
            return;
        }

        if (inCart != null)
        {
            inCart.Quantity += quantity;
        }
        else
        {
            Session.Cart.Add(new OrderItem
            {
