# 9. `Lab6.Api → Program.cs`

**Полностью удали старый код** и вставь:

```csharp
using System;

var builder = WebApplication.CreateBuilder(args);
var app = builder.Build();

app.MapGet("/user", (string? id) =>
{
    try
    {
        if (id == null || !int.TryParse(id, out int userId))
        {
            return Results.Json(
                new
                {
                    error = "Invalid ID format",
                    statusCode = 400
                },
                statusCode: 400
            );
        }

        if (userId != 123)
        {
            return Results.Json(
                new
                {
                    error = "User not found",
                    statusCode = 404
                },
                statusCode: 404
            );
        }

        return Results.Ok(new
        {
            id = 123,
            name = "Ivan"
        });
    }
    catch (Exception ex)
    {
        File.AppendAllText("errors.log", ex + "\n");

        return Results.Json(
            new
            {
                error = "Internal server error",
                statusCode = 500
            },
            statusCode: 500
        );
    }
});

app.Run();
```

Это **5.5**.

