# 7. `Program.cs`

А вот тут мы всё собираем:

```csharp
using System;

class Program
{
    static void Main()
    {
        GlobalException.Setup();

        Console.WriteLine("=== 5.1 Обработка исключений ===");
        ExceptionTask.Run();

        Console.WriteLine();
        Console.WriteLine("=== 5.2 Пользовательское исключение ===");

        try
        {
            Console.Write("Введите число: ");
            int number = int.Parse(Console.ReadLine());

            if (number < 0)
                throw new NegativeNumberException(
                    "Число не может быть отрицательным."
                );

            Console.WriteLine("Число: " + number);
        }
        catch (NegativeNumberException ex)
        {
            Console.WriteLine("Ошибка: " + ex.Message);
        }
        catch (FormatException)
        {
            Console.WriteLine("Введите именно число.");
        }

        Console.WriteLine();
        Console.WriteLine("=== 5.3 Работа с файлом ===");
        FileTask.Run();

        Console.WriteLine();
        Console.WriteLine("Готово!");
    }
}
```

Теперь **5.1–5.4 работают из одного `Program.cs`**.

