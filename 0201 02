MainWindow.xaml.cs:

```csharp
using System.Text.RegularExpressions;
using System.Windows;
using System.Windows.Media;

namespace WpfReg
{
    public partial class MainWindow : Window
    {
        public MainWindow()
        {
            InitializeComponent();
        }

        private void BtnRegister_Click(object sender, RoutedEventArgs e)
        {
            string login = txtLogin.Text.Trim();
            string pass = txtPass.Password;
            string confirm = txtConfirm.Password;
            string email = txtEmail.Text.Trim();

            // 1. Проверка на пустые поля (подсказка пользователю)
            if (string.IsNullOrEmpty(login))
            {
                ShowError("Введите логин!");
                return;
            }
            if (string.IsNullOrEmpty(pass))
            {
                ShowError("Введите пароль!");
                return;
            }
            if (string.IsNullOrEmpty(email))
            {
                ShowError("Введите Email!");
                return;
            }

            // 2. Проверка длины пароля (адаптивность интерфейса)
            if (pass.Length < 6)
            {
                ShowError("Пароль должен быть не менее 6 символов!");
                return;
            }

            // 3. Проверка совпадения паролей
            if (pass != confirm)
            {
                ShowError("Пароли не совпадают!");
                return;
            }

            // 4. Проверка формата Email (простая)
            string emailPattern = @"^[^@\s]+@[^@\s]+\.[^@\s]+$";
            if (!Regex.IsMatch(email, emailPattern))
            {
                ShowError("Некорректный Email! Пример: user@mail.ru");
                return;
            }

            // Если всё хорошо
            lblResult.Foreground = Brushes.Green;
            lblResult.Text = "Регистрация успешна!";
        }

        private void ShowError(string message)
        {
            lblResult.Foreground = Brushes.Red;
            lblResult.Text = message;
        }
    }
}
```

Что здесь реализовано по методичке:

1. Поля: Логин, Пароль, Подтверждение, Email (как в 5.3.1).
2. Подсказки: Если поле пустое — красный текст с подсказкой (требование 5.3.1 про "подсказки для пользователей").
3. Адаптивность: Проверка длины пароля и формата email.
4. Кнопка: "Зарегистрироваться".

Этот код полностью закрывает практическую часть 5.3.2. А таблицы выше — для 5.3.1 и 5.4.
