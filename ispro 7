# 5. Создай `Task53.cs`

```csharp
using System;
using System.Diagnostics;

static class Task53
{
    public static void Run()
    {
        var ts = new TraceSource("Calculator")
        {
            Switch = new SourceSwitch("CalculatorSwitch")
            {
                Level = SourceLevels.Information
            }
        };

        ts.Listeners.Clear();

        ts.Listeners.Add(
            new TextWriterTraceListener("trace.log"));

        ts.Listeners.Add(
            new ConsoleTraceListener());

        ts.AutoFlush = true;

        try
        {
            Console.Write("Введите первое число: ");
            int a = int.Parse(Console.ReadLine());

            Console.Write("Введите второе число: ");
            int b = int.Parse(Console.ReadLine());

            ts.TraceEvent(
                TraceEventType.Verbose,
                0,
                $"Входные данные: {a}, {b}");

            ts.TraceInformation(
                $"Начало операций: {a}, {b}");

            int sum = a + b;
            Console.WriteLine("Сложение: " + sum);

            ts.TraceInformation(
                $"Результат сложения: {sum}");

            int sub = a - b;
            Console.WriteLine("Вычитание: " + sub);

            ts.TraceInformation(
                $"Результат вычитания: {sub}");

            int mul = a * b;
            Console.WriteLine("Умножение: " + mul);

            ts.TraceInformation(
                $"Результат умножения: {mul}");

            if (b == 0)
                throw new DivideByZeroException(
                    "Деление на ноль.");

            int div = a / b;

            Console.WriteLine("Деление: " + div);

            ts.TraceInformation(
                $"Результат деления: {div}");
        }
        catch (Exception ex)
        {
            Console.WriteLine("Ошибка: " + ex.Message);

            ts.TraceEvent(
                TraceEventType.Error,
                1,
                ex.ToString());
        }
        finally
        {
            ts.Flush();
            ts.Close();
        }

        Console.WriteLine("Лог записан в trace.log");
    }
}
```

Здесь есть `TraceSource`, `TextWriterTraceListener`, `ConsoleTraceListener`, уровни `Verbose`, `Information`, `Error`. Именно это требуется в 5.3. 

**Важно:** сейчас стоит:

```csharp
Level = SourceLevels.Information
```

Поэтому `Verbose` в лог не попадёт — это специально предусмотрено заданием. Чтобы проверить `Verbose`, поменяй на:

```csharp
Level = SourceLevels.Verbose
```



