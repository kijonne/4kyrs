# 4. Создай `Task52.cs`

```csharp
using System;
using System.Diagnostics;
using System.IO;
using System.Threading;

static class Task52
{
    public static void Run()
    {
        long totalTime = 0;

        for (int operation = 1; operation <= 3; operation++)
        {
            long operationTime = 0;

            for (int i = 1; i <= 3; i++)
            {
                Stopwatch stopwatch = Stopwatch.StartNew();

                if (operation == 1)
                {
                    File.WriteAllText(
                        "test.txt",
                        new string('A', 10000));

                    string text = File.ReadAllText("test.txt");
                }
                else if (operation == 2)
                {
                    double result = 0;

                    for (int j = 0; j < 500000; j++)
                    {
                        result += Math.Sqrt(j);
                    }
                }
                else
                {
                    Thread.Sleep(50);
                }

                stopwatch.Stop();

                long ms = stopwatch.ElapsedMilliseconds;

                operationTime += ms;
                totalTime += ms;

                string name;

                if (operation == 1)
                    name = "ReadTxtFile";
                else if (operation == 2)
                    name = "MathCalculation";
                else
                    name = "DelayOperation";

                string log =
                    $"[{DateTime.Now:yyyy-MM-dd HH:mm:ss}] " +
                    $"Operation={name}, Run={i}, Elapsed={ms} ms\n";

                Debug.WriteLine(log);
                File.AppendAllText("timings.log", log);
            }

            long average = operationTime / 3;

            Console.WriteLine(
                $"Операция {operation}: среднее время = {average} мс");

            File.AppendAllText(
                "timings.log",
                $"Среднее время операции {operation}: {average} мс\n");
        }

        Console.WriteLine(
            $"Общее время выполнения: {totalTime} мс");
    }
}
```

Это **5.2** — каждая операция выполняется 3 раза, считается среднее время и всё пишется в `timings.log`. 

