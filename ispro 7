# 6. Создай `Task54.cs`

```csharp
using System;
using System.Diagnostics;

static class Task54
{
    public static void Run()
    {
        var sourceSwitch = new SourceSwitch("StorageSwitch")
        {
            Level = SourceLevels.Warning
        };

        var ts = new TraceSource("Storage")
        {
            Switch = sourceSwitch
        };

        ts.Listeners.Clear();

        ts.Listeners.Add(
            new TextWriterTraceListener("storage.log"));

        ts.AutoFlush = true;

        try
        {
            ts.TraceEvent(
                TraceEventType.Verbose,
                0,
                "Входные данные: id=1");

            ts.TraceInformation(
                "Начало загрузки данных.");

            ts.TraceInformation(
                "Загрузка данных завершена.");

            ts.TraceEvent(
                TraceEventType.Warning,
                1,
                "Попытка удалить несуществующую запись.");

            try
            {
                throw new Exception(
                    "Ошибка при сохранении данных.");
            }
            catch (Exception ex)
            {
                ts.TraceEvent(
                    TraceEventType.Error,
                    2,
                    ex.ToString());

                Console.WriteLine(
                    "Ошибка: " + ex.Message);
            }
        }
        finally
        {
            ts.Flush();
            ts.Close();
        }

        Console.WriteLine(
            "Лог записан в storage.log.");

        Console.WriteLine(
            "Сейчас уровень: Warning.");
    }
}
```

Это **5.4**.

Сейчас:

```csharp
Level = SourceLevels.Warning
```

Поэтому попадут:

```text
Warning
Error
```

Чтобы проверить все сообщения:

```csharp
Level = SourceLevels.Verbose
```

А чтобы полностью выключить логирование:

```csharp
Level = SourceLevels.Off
```

Именно эти проверки указаны в методичке. 

