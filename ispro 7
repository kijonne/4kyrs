# 3. Создай `Task51.cs`

ПКМ по проекту → **Добавить → Класс** → `Task51.cs`

```csharp
using System;
using System.IO;

static class Task51
{
    public static void Run()
    {
        try
        {
            Console.Write("Введите первое целое число: ");
            int a = int.Parse(Console.ReadLine());

            Console.Write("Введите второе целое число: ");
            int b = int.Parse(Console.ReadLine());

            Console.WriteLine("Сложение: " + (a + b));
            Console.WriteLine("Вычитание: " + (a - b));
            Console.WriteLine("Умножение: " + (a * b));
            Console.WriteLine("Деление: " + (a / b));
        }
        catch (FormatException ex)
        {
            LogError(ex);
        }
        catch (OverflowException ex)
        {
            LogError(ex);
        }
        catch (DivideByZeroException ex)
        {
            LogError(ex);
        }
        catch (Exception ex)
        {
            LogError(ex);
        }
    }

    static void LogError(Exception ex)
    {
        Console.WriteLine("Ошибка: " + ex.Message);

        string text =
            $"[{DateTime.Now:yyyy-MM-dd HH:mm:ss}] " +
            $"{ex.GetType().Name}: {ex.Message}\n" +
            $"{ex}\n";

        File.AppendAllText("log.txt", text);

        Console.WriteLine("Ошибка записана в log.txt");
    }
}
```

Это **5.1**: разные `catch`, сообщение об ошибке и запись в `log.txt`. 

