`MainWindow.xaml.cs`, **замени всё содержимое**:

```csharp
using Microsoft.Win32;
using System.Windows;

namespace LabWork7;

public partial class MainWindow : Window
{
    private readonly ScriptingHost _host = new();

    public MainWindow()
    {
        InitializeComponent();

        EventsGrid.ItemsSource = EventStore.Events;
        DateBox.SelectedDate = DateTime.Today;

        // 5.2.2: сервер канала в отдельном Task
        Task.Run(() => _host.Run());
    }

    // 5.1.6: кнопка «Выполнить»
    private async void RunButton_Click(object sender, RoutedEventArgs e)
    {
        try
        {
            await _host.ExecuteAsync(ScriptTextBox.Text);
        }
        catch (Exception ex)
        {
            MessageBox.Show(ex.Message, "Ошибка скрипта");
        }
    }

    // 5.5: выполнение скрипта из файла
    private async void RunFileButton_Click(object sender, RoutedEventArgs e)
    {
        var dialog = new OpenFileDialog { Filter = "Текстовые файлы (*.txt)|*.txt|Все файлы|*.*" };
        if (dialog.ShowDialog() != true) return;

        try
        {
            await _host.ExecuteFileAsync(dialog.FileName);
        }
        catch (Exception ex)
        {
            MessageBox.Show(ex.Message, "Ошибка скрипта");
        }
    }

    // 5.3: добавление события через интерфейс
    private void AddEventButton_Click(object sender, RoutedEventArgs e)
    {
        if (DateBox.SelectedDate == null || !TimeSpan.TryParse(TimeBox.Text, out var time))
        {
            MessageBox.Show("Проверьте дату и время (пример времени: 14:30)");
            return;
        }

        EventStore.Events.Add(new EventItem
        {
            Id = EventStore.NextId(),
            Title = TitleBox.Text,
            Description = DescriptionBox.Text,
            DateTime = DateBox.SelectedDate.Value.Date + time
        });

        TitleBox.Clear();
        DescriptionBox.Clear();
    }
}
```

