## 3. Класс Automation (5.1.3 и 5.4)

Класс `Automation.cs`. Он должен быть `public`. Через `Dispatcher` действия выполняются в потоке окна, иначе команды из канала упадут с ошибкой потока.

```csharp
using System.Globalization;
using System.Windows;

namespace LabWork7;

public class Automation
{
    private static void Ui(Action a) => Application.Current.Dispatcher.Invoke(a);
    private static T Ui<T>(Func<T> f) => Application.Current.Dispatcher.Invoke(f);

    private static DateTime Parse(string s) =>
        DateTime.Parse(s, CultureInfo.GetCultureInfo("ru-RU"));

    // 5.1.3
    public void Message(string text) => Ui(() => MessageBox.Show(text));

    // 5.4 CRUD
    // Create
    public int AddEvent(string title, string description, string dateTime)
    {
        var date = Parse(dateTime);
        return Ui(() =>
        {
            var e = new EventItem
            {
                Id = EventStore.NextId(),
                Title = title,
                Description = description,
                DateTime = date
            };
            EventStore.Events.Add(e);
            return e.Id;
        });
    }

    // Read
    public string GetEvent(int id) => Ui(() =>
    {
        var e = EventStore.Events.First(x => x.Id == id);
        return $"{e.Id}: {e.DateTime:dd.MM.yyyy HH:mm} {e.Title} - {e.Description}";
    });

    // Update
    public void UpdateEvent(int id, string title, string description, string dateTime)
    {
        var date = Parse(dateTime);
        Ui(() =>
        {
            var index = EventStore.Events.IndexOf(EventStore.Events.First(x => x.Id == id));
            EventStore.Events[index] = new EventItem
            {
                Id = id,
                Title = title,
                Description = description,
                DateTime = date
            };
        });
    }

    // Delete
    public void DeleteEvent(int id) => Ui(() =>
    {
        EventStore.Events.Remove(EventStore.Events.First(x => x.Id == id));
    });
}
```

## 4. Класс ScriptingHost (5.1.4, 5.1.5, 5.2.1, 5.5)

Класс `ScriptingHost.cs`:

```csharp
using Microsoft.CodeAnalysis.CSharp.Scripting;
using Microsoft.CodeAnalysis.Scripting;
using System.IO;
using System.IO.Pipes;

namespace LabWork7;

public class ScriptingHost
{
    // 5.1.5: приватное поле, инициализация в конструкторе
    private ScriptOptions scriptOptions;

    public ScriptingHost()
    {
        // Фильтр нужен, чтобы не упасть на динамических сборках
        var assemblies = AppDomain.CurrentDomain.GetAssemblies()
            .Where(a => !a.IsDynamic && !string.IsNullOrEmpty(a.Location));

        scriptOptions = ScriptOptions.Default
            .WithReferences(assemblies)
            .WithImports("System", "System.Collections.Generic", "System.Linq");
    }

    // 5.1.4
    public async Task ExecuteAsync(string code)
    {
        await CSharpScript.EvaluateAsync(code, scriptOptions, new Automation());
    }

    // 5.5: скрипт из текстового файла
    public async Task ExecuteFileAsync(string path)
    {
        string code = await File.ReadAllTextAsync(path);
        await ExecuteAsync(code);
    }

    // 5.2.1: сервер именованного канала
    public async Task Run()
    {
        while (true)
        {
            using (NamedPipeServerStream server = new NamedPipeServerStream("mypipe", PipeDirection.In))
            {
                await server.WaitForConnectionAsync();
                await HandleClient(server);
            }
        }
    }

    // Читаем команды от клиента построчно и выполняем
    private async Task HandleClient(NamedPipeServerStream server)
    {
        using var reader = new StreamReader(server);
        string? line;
        while ((line = await reader.ReadLineAsync()) != null)
        {
            try
            {
                await ExecuteAsync(line);
            }
            catch
            {
                // Ошибка в одной команде не должна ронять сервер
            }
        }
    }
}
```

