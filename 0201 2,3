## Задание 2 — парное программирование

Сделай проект **Windows Forms App**. В `Form1.cs` вставь:

```csharp
using System;
using System.Collections.Generic;
using System.Windows.Forms;

namespace Lab1
{
    public partial class Form1 : Form
    {
        // Список пользователей
        List<string> users = new List<string>();

        public Form1()
        {
            InitializeComponent();
        }

        // Регистрация
        private void btnRegister_Click(object sender, EventArgs e)
        {
            string login = txtLogin.Text;
            string password = txtPassword.Text;

            if (login == "" || password == "")
            {
                MessageBox.Show("Заполните все поля");
                return;
            }

            if (users.Contains(login))
            {
                MessageBox.Show("Такой пользователь уже существует");
                return;
            }

            users.Add(login);

            MessageBox.Show("Пользователь зарегистрирован");
            ShowUsers();
        }

        // Авторизация
        private void btnLogin_Click(object sender, EventArgs e)
        {
            string login = txtLogin.Text;

            if (users.Contains(login))
            {
                MessageBox.Show("Авторизация успешна");
            }
            else
            {
                MessageBox.Show("Пользователь не найден");
            }
        }

        // Вывод списка пользователей
        private void ShowUsers()
        {
            listUsers.Items.Clear();

            foreach (string user in users)
            {
                listUsers.Items.Add(user);
            }
        }
    }
}
```

На форме создай:

* `TextBox` → **txtLogin**
* `TextBox` → **txtPassword**
* `Button` → **btnRegister**, текст: `Регистрация`
* `Button` → **btnLogin**, текст: `Войти`
* `ListBox` → **listUsers**

И два раза нажми на кнопки, чтобы Visual Studio создала обработчики `btnRegister_Click` и `btnLogin_Click`.

Для отчёта по парному программированию можно написать:

> В ходе работы участники поочерёдно выполняли роли ведущего и штурмана. Ведущий писал код приложения, а штурман контролировал правильность написания кода и указывал на найденные ошибки. После нескольких итераций участники поменялись ролями.

