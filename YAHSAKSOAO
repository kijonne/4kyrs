# Используем минимальный базовый образ Python (slim)
FROM python:3.11-slim

# Метаданные (п. 4.2)
LABEL maintainer="student@example.com"
LABEL description="FastAPI Random Number App"

# Открываем порт
EXPOSE 8000

# Устанавливаем рабочую директорию
WORKDIR /app

# Копируем только requirements, чтобы закешировать установку зависимостей
COPY requirements.txt .

# Устанавливаем зависимости (без кеша pip для уменьшения размера)
RUN pip install --no-cache-dir -r requirements.txt

# Копируем остальной код
COPY main.py .

# Проверка здоровья (п. 4.3) - используем встроенный Python, т.к. curl нет
HEALTHCHECK --interval=30s --timeout=3s \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/')" || exit 1

# Команда запуска
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
