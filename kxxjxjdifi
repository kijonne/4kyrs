5.2.2 Разработка методов (Код C#)

```csharp
using System;
using System.Text.RegularExpressions;

public class LabMethods
{
    // 5.2.2 Метод 1: Возведение в степень
    public static double CalculatePower(double a, int n)
    {
        if (a == 0 && n < 0)
        {
            throw new ArgumentException("Ноль нельзя возводить в отрицательную степень.");
        }
        // Math.Pow возвращает double
        double result = Math.Pow(a, n);
        // Округляем до 3 знаков после запятой
        return Math.Round(result, 3);
    }

    // 5.2.2 Метод 2: Проверка надежности пароля
    public static bool IsPasswordReliable(string password)
    {
        if (string.IsNullOrEmpty(password)) return false;

        // 1. Проверка длины
        if (password.Length < 8 || password.Length > 30) return false;

        // 2. Проверка наличия цифр
        bool hasDigit = Regex.IsMatch(password, @"\d");
        
        // 3. Проверка наличия только латинских букв (верхний и нижний регистр)
        bool hasUpper = Regex.IsMatch(password, @"[A-Z]");
        bool hasLower = Regex.IsMatch(password, @"[a-z]");
        
        // 4. Проверка наличия спецсимволов (знаки препинания и мат. действий)
        // Ищем символы, которые НЕ являются буквами и НЕ являются цифрами
        bool hasSpecial = Regex.IsMatch(password, @"[^a-zA-Z0-9]");
        
        // 5. Проверка, что нет посторонних символов (например, кириллицы)
        // Строка должна состоять только из разрешенных символов
        bool onlyValidChars = Regex.IsMatch(password, @"^[a-zA-Z0-9!@#$%^&*()_+\-=\[\]{};':""\\|,.<>\/?~`]+$");

        return hasDigit && hasUpper && hasLower && hasSpecial && onlyValidChars;
    }
}
```

