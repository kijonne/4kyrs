### `MainWindow.xaml.cs`
csharp
using System.Windows;
using Microsoft.Win32;
using UserManagerWpf.Services;

namespace UserManagerWpf;

public partial class MainWindow : Window
{
    private readonly UserService _svc;

    public MainWindow(UserService svc, string currentUser)
    {
        InitializeComponent();
        _svc = svc;
        UserLabel.Text = $"Вы вошли: {currentUser}";
        LoadUsers();
    }

    private void LoadUsers() => UsersGrid.ItemsSource = _svc.GetAll();

    private void Refresh_Click(object sender, RoutedEventArgs e) => LoadUsers();

    private void Export_Click(object sender, RoutedEventArgs e)
    {
        var dlg = new SaveFileDialog { Filter = "JSON|*.json", FileName = "users.json" };
        if (dlg.ShowDialog() == true)
        {
            _svc.Export(dlg.FileName);
            MessageBox.Show("Экспорт выполнен");
        }
    }

    private void Import_Click(object sender, RoutedEventArgs e)
    {
        var dlg = new OpenFileDialog { Filter = "JSON|*.json" };
        if (dlg.ShowDialog() == true)
        {
            MessageBox.Show(_svc.Import(dlg.FileName) ? "Импорт выполнен" : "Ошибка импорта");
            LoadUsers();
        }
    }

    private void Logout_Click(object sender, RoutedEventArgs e)
    {
        new LoginWindow().Show();
        Close();
    }
}

