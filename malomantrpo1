using System.Windows;
using UserManagerWpf.Services;

namespace UserManagerWpf;

public partial class LoginWindow : Window
{
    private readonly UserService _svc = new();

    public LoginWindow()
    {
        InitializeComponent();
    }

    private void Login_Click(object sender, RoutedEventArgs e)
    {
        var user = _svc.Login(UsernameBox.Text, PasswordBox.Password);
        if (user == null)
        {
            MessageBox.Show("Неверный логин или пароль", "Ошибка", MessageBoxButton.OK, MessageBoxImage.Warning);
            return;
        }
        var main = new MainWindow(_svc, user.Username);
        main.Show();
        Close();
    }

    private void Register_Click(object sender, RoutedEventArgs e)
    {
        var reg = new RegisterWindow(_svc);
        reg.Owner = this;
        reg.ShowDialog();
    }
}

