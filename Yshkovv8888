Задание 4. Gitea + MySQL

4.1. Папка и .env

```bash
cd ~/lw8
mkdir -p 02-gitea-mysql
cd 02-gitea-mysql
nano .env
```

Вставь:

```
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=gitea
MYSQL_USER=gitea
MYSQL_PASSWORD=giteapass
```

Сохрани: Ctrl+O, Enter, Ctrl+X.

4.2. docker-compose.yml

```bash
nano docker-compose.yml
```

```yaml
services:
  db:
    image: mysql:8.0.39
    container_name: lw8-gitea-db
    restart: unless-stopped
    environment:
      MYSQL_ROOT_PASSWORD: ${MYSQL_ROOT_PASSWORD}
      MYSQL_DATABASE: ${MYSQL_DATABASE}
      MYSQL_USER: ${MYSQL_USER}
      MYSQL_PASSWORD: ${MYSQL_PASSWORD}
    volumes:
      - gitea_db:/var/lib/mysql
    networks:
      - backend

  gitea:
    image: gitea/gitea:1.22.3
    container_name: lw8-gitea
    restart: unless-stopped
    depends_on:
      - db
    environment:
      GITEA__database__DB_TYPE: mysql
      GITEA__database__HOST: db:3306
      GITEA__database__NAME: ${MYSQL_DATABASE}
      GITEA__database__USER: ${MYSQL_USER}
      GITEA__database__PASSWD: ${MYSQL_PASSWORD}
    ports:
      - "3000:3000"
      - "2222:22"
    volumes:
      - gitea_data:/data
    networks:
      - backend
      - frontend

volumes:
  gitea_db:
  gitea_data:

networks:
  backend:
    internal: true
  frontend:
```

4.3. Запуск

```bash
docker compose up -d
docker compose ps
```

Открой http://localhost:3000. При первом запуске нажми «Install Gitea» — настройки БД уже подставятся из env.

